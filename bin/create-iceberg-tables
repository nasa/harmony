        {"id": 11, "name": "retry_count", "type": "int"},
        {"id": 12, "name": "duration", "type": "float"},
        {"id": 13, "name": "started_at", "type": "timestamptz"},
        {"id": 14, "name": "sort_index", "type": "int"},
        {"id": 15, "name": "output_item_sizes_json", "type": "string"},
        {"id": 16, "name": "message_category", "type": "string"}
      ]
