        {"id": 2, "name": "job_id", "type": "string"},
        {"id": 3, "name": "workflow_step_index", "type": "int"},
        {"id": 4, "name": "scroll_id", "type": "string"},
        {"id": 5, "name": "service_id", "type": "string"},
        {"id": 6, "name": "status", "type": "string"},
        {"id": 7, "name": "stac_catalog_location", "type": "string"},
        {"id": 8, "name": "created_at", "type": "timestamptz"},
        {"id": 9, "name": "updated_at", "type": "timestamptz"},
