          "name": "updated_at_month"
        }
      ]
    }
  }
}
EOF
)"
"$(cat <<'EOF'
{
  "iceberg": {
    "schema": {
      "fields": [
        {"id": 1, "name": "id", "type": "long"},
        {"id": 2, "name": "request_id", "type": "string"},
        {"id": 3, "name": "username", "type": "string"},
        {"id": 4, "name": "status", "type": "string"},
        {"id": 5, "name": "progress", "type": "int"},
        {"id": 6, "name": "created_at", "type": "timestamptz"},
        {"id": 7, "name": "updated_at", "type": "timestamptz"},
        {"id": 8, "name": "request", "type": "string"},
        {"id": 9, "name": "is_async", "type": "boolean"},
        {"id": 10, "name": "batches_completed", "type": "int"},
        {"id": 11, "name": "num_input_granules", "type": "int"},
        {"id": 12, "name": "message", "type": "string"},
        {"id": 13, "name": "job_id", "type": "string"},
        {"id": 14, "name": "collection_ids", "type": "string"},
        {"id": 15, "name": "ignore_errors", "type": "boolean"},
        {"id": 16, "name": "destination_url", "type": "string"},
        {"id": 17, "name": "service_name", "type": "string"},
        {"id": 18, "name": "provider_id", "type": "string"},
        {"id": 19, "name": "original_data_size", "type": "double"},
        {"id": 20, "name": "output_data_size", "type": "double"}
      ]
    },
    "partitionSpec": {
      "fields": [
        {
          "sourceId": 7,
          "transform": "month",
          "name": "updated_at_month"
        }
      ]
    }
  }
}
EOF
)"
"$(cat <<'EOF'
{
  "iceberg": {
    "schema": {
      "fields": [
        {"id": 1, "name": "id", "type": "long"},
        {"id": 2, "name": "job_id", "type": "string"},
        {"id": 3, "name": "label_id", "type": "long"},
        {"id": 4, "name": "created_at", "type": "timestamptz"},
        {"id": 5, "name": "updated_at", "type": "timestamptz"}
      ]
    },
    "partitionSpec": {
      "fields": [
        {
          "sourceId": 5,
          "transform": "month",
          "name": "updated_at_month"
        }
      ]
    }
  }
}
EOF
)"
"$(cat <<'EOF'
{
  "iceberg": {
    "schema": {
      "fields": [
        {"name": "id", "type": "long"},
        {"name": "value", "type": "string"},
        {"name": "created_at", "type": "timestamptz"},
        {"name": "updated_at", "type": "timestamptz"}
      ]
    }
  }
}
EOF
)"
"$(cat <<'EOF'
{
  "iceberg": {
    "schema": {
      "fields": [
        {"name": "id", "type": "long"},
        {"name": "deployment_id", "type": "string"},
        {"name": "username", "type": "string"},
        {"name": "service", "type": "string"},
        {"name": "tag", "type": "string"},
        {"name": "status", "type": "string"},
        {"name": "message", "type": "string"},
        {"name": "created_at", "type": "timestamptz"},
        {"name": "updated_at", "type": "timestamptz"},
        {"name": "regression_test_version", "type": "string"}
      ]
    }
  }
}
EOF
)"
"$(cat <<'EOF'
{
  "iceberg": {
    "schema": {
      "fields": [
        {"name": "id", "type": "long"},
        {"name": "username", "type": "string"},
