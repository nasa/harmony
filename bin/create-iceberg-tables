#!/usr/bin/env bash

set -e

BUCKET_NAME="harmony-analytics"
NAMESPACE="iceberg"

AWS_REGION="${AWS_REGION:-$AWS_DEFAULT_REGION}"

ACCOUNT_ID=$(aws "$AWS_ENDPOINT_FLAG" sts get-caller-identity --query "Account" --output text)

BUCKET_ARN="arn:aws:s3tables:${AWS_REGION}:${ACCOUNT_ID}:bucket/${BUCKET_NAME}"

if ERROR_MSG=$(aws "$AWS_ENDPOINT_FLAG" s3tables get-table-bucket --table-bucket-arn "$BUCKET_ARN" 2>&1 >/dev/null); then
    echo "S3 Table Bucket [${BUCKET_NAME}] already exists, skipping creation."
    exit 0
fi

if [[ ! "$ERROR_MSG" =~ "NotFoundException" && ! "$ERROR_MSG" =~ "ResourceNotFoundException" ]]; then
    echo "Error checking S3 Table bucket status:" >&2
    echo "$ERROR_MSG" >&2
    exit 1
fi

echo "🚀 Starting S3 Tables provisioning..."

#  Create the S3 Table Bucket
echo "Creating S3 Table Bucket: $BUCKET_NAME..."
aws "$AWS_ENDPOINT_FLAG" s3tables create-table-bucket \
    --name "$BUCKET_NAME"
    
echo "BUCKET_ARN: $BUCKET_ARN"
 
# orphan file cleanup is not available in ministack, apparently, so don't try to set it there   
if [[ ! -v AWS_ENDPOINT_FLAG ]]; then
  # Set the bucket config to clean up orphan files using the default settings (unreferenced for 3 days and waiting for deletion for 10 days)
  echo "Enabling orphan file clean up"
  aws s3tables put-table-bucket-maintenance-configuration --table-bucket-arn $BUCKET_ARN --type icebergUnreferencedFileRemoval \
  --value 'status=enabled,settings={icebergUnreferencedFileRemoval={unreferencedDays=3,nonCurrentDays=10}}'
fi

echo "✅ Table Bucket created: $BUCKET_ARN"

# 2. Create the Namespace
echo "Creating Namespace: $NAMESPACE..."
aws "$AWS_ENDPOINT_FLAG" s3tables create-namespace \
    --table-bucket-arn "$BUCKET_ARN" \
    --namespace "$NAMESPACE"


declare -A TABLE_SCHEMAS

TABLE_SCHEMAS["batch_items"]=$(cat <<'EOF'
{
  "iceberg": {
    "schema": {
      "fields": [
        {"name": "id", "type": "long"},
        {"name": "job_id", "type": "string"},
        {"name": "service_id", "type": "string"},
        {"name": "batch_id", "type": "int"},
        {"name": "stac_item_url", "type": "string"},
        {"name": "item_size", "type": "long"},
        {"name": "sort_index", "type": "int"},
        {"name": "created_at", "type": "timestamptz"},
        {"name": "updated_at", "type": "timestamptz"}
      ]
    }
  }
}
EOF
)

