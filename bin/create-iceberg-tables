create_table() {
  local table_name="$1"
  local schema_json="$2"
  local error_msg
  local max_attempts=3
  local attempt=1

  echo "Creating table: ${table_name}..."

  while true; do
    if error_msg=$(aws "${AWS_FLAGS[@]}" s3tables create-table \
      --table-bucket-arn "$BUCKET_ARN" \
      --namespace "$NAMESPACE" \
      --name "$table_name" \
      --format "ICEBERG" \
      --metadata "$schema_json" 2>&1 >/dev/null); then
      echo "Table '${table_name}' created successfully."
      break
    elif [[ "$error_msg" =~ "ConflictException" || "$error_msg" =~ "already exists" ]]; then
      # A ConflictException can also mean a conflicting concurrent write (more likely now that
      # the tables are created in parallel), so confirm the table exists before skipping it
      if aws "${AWS_FLAGS[@]}" s3tables get-table \
        --table-bucket-arn "$BUCKET_ARN" \
        --namespace "$NAMESPACE" \
        --name "$table_name" >/dev/null 2>&1; then
        echo "Table '${table_name}' already exists, skipping."
        break
      fi
    fi

    if [ "$attempt" -ge "$max_attempts" ] || [[ ! "$error_msg" =~ "ConflictException" && ! "$error_msg" =~ "already exists" ]]; then
      echo "Error creating table '${table_name}':"
      echo "$error_msg"
      return 1
    fi

    echo "Conflict creating table '${table_name}' but the table does not exist, retrying..."
    attempt=$((attempt + 1))
    sleep 1
  done

  echo "----------------------------------------"
}

# Create the tables in parallel, since each aws call is slow. Each table's output is captured
# and then printed in table order, as if they had been created one at a time.
LOG_DIR=$(mktemp -d)
trap 'rm -rf "$LOG_DIR"' EXIT

PIDS=()
INDEX=0
while [ "$INDEX" -lt "${#TABLE_NAMES[@]}" ]; do
  create_table "${TABLE_NAMES[$INDEX]}" "${TABLE_SCHEMAS[$INDEX]}" > "${LOG_DIR}/${INDEX}.log" 2>&1 &
  PIDS+=($!)
  INDEX=$((INDEX + 1))
done

STATUSES=()
INDEX=0
while [ "$INDEX" -lt "${#PIDS[@]}" ]; do
  if wait "${PIDS[$INDEX]}"; then
    STATUSES+=(0)
  else
    STATUSES+=(1)
  fi
  INDEX=$((INDEX + 1))
done

FAILED=0
INDEX=0
while [ "$INDEX" -lt "${#TABLE_NAMES[@]}" ]; do
  cat "${LOG_DIR}/${INDEX}.log" >&2
  if [ "${STATUSES[$INDEX]}" -ne 0 ]; then
    FAILED=1
  fi
  INDEX=$((INDEX + 1))
done

if [ "$FAILED" -ne 0 ]; then
  exit 1
fi

# Sole stdout output: callers capture this via `arn=$(./bin/create-iceberg-tables)`.
echo "$BUCKET_ARN"
