EOF
)"
"$(cat <<'EOF'
{
  "iceberg": {
    "schema": {
      "fields": [
        {"id": 1, "name": "id", "type": "long"},
        {"id": 2, "name": "job_id", "type": "string"},
        {"id": 3, "name": "service_id", "type": "string"},
        {"id": 4, "name": "step_index", "type": "int"},
        {"id": 5, "name": "work_item_count", "type": "int"},
        {"id": 6, "name": "operation", "type": "string"},
        {"id": 7, "name": "created_at", "type": "timestamptz"},
        {"id": 8, "name": "updated_at", "type": "timestamptz"},
        {"id": 9, "name": "has_aggregated_output", "type": "boolean"},
        {"id": 10, "name": "max_batch_inputs", "type": "long"},
        {"id": 11, "name": "max_batch_size_in_bytes", "type": "long"},
        {"id": 12, "name": "is_batched", "type": "boolean"},
        {"id": 13, "name": "is_complete", "type": "boolean"},
        {"id": 14, "name": "is_sequential", "type": "boolean"},
        {"id": 15, "name": "completed_work_item_count", "type": "int"},
        {"id": 16, "name": "progress_weight", "type": "float"},
        {"id": 17, "name": "always_wait_for_prior_step", "type": "boolean"}
      ]
    },
    "partitionSpec": {
      "fields": [
        {
          "sourceId": 8,
          "transform": "month",
          "name": "updated_at_month"
        }
      ]
    }
  }
}
EOF
)"
)

# Iterate and Create Tables
INDEX=0
while [ "$INDEX" -lt "${#TABLE_NAMES[@]}" ]; do
  TABLE_NAME="${TABLE_NAMES[$INDEX]}"
  SCHEMA_JSON="${TABLE_SCHEMAS[$INDEX]}"

  echo "Creating table: ${TABLE_NAME}..." >&2

  if ERROR_MSG=$(aws "${AWS_FLAGS[@]}" s3tables create-table \
    --table-bucket-arn "$BUCKET_ARN" \
    --namespace "$NAMESPACE" \
    --name "$TABLE_NAME" \
    --format "ICEBERG" \
    --metadata "$SCHEMA_JSON" 2>&1 >/dev/null); then
    echo "Table '${TABLE_NAME}' created successfully." >&2
  elif [[ "$ERROR_MSG" =~ "ConflictException" || "$ERROR_MSG" =~ "already exists" ]]; then
    echo "Table '${TABLE_NAME}' already exists, skipping." >&2
  else
    echo "Error creating table '${TABLE_NAME}':" >&2
    echo "$ERROR_MSG" >&2
    exit 1
  fi

  echo "----------------------------------------" >&2

  INDEX=$((INDEX + 1))
done

# Sole stdout output: callers capture this via `arn=$(./bin/create-iceberg-tables)`.
echo "$BUCKET_ARN"
