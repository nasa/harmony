#!/bin/bash
#
# Builds public/js/vendor/codemirror.js, the SQL editor used by /admin/analytics, from the pinned
# versions in vendor-build/codemirror. The bundle is committed, so this only needs to be run to
# change what it includes or to update CodeMirror (edit vendor-build/codemirror/package.json, run
# this, and commit the updated package-lock.json and bundle).
#
# It builds in a temporary directory rather than adding CodeMirror and esbuild to harmony's own
# dependencies: they are only needed to produce the bundle, and the browser loads the bundle as a
# static file.

set -e

cd "$(dirname "$0")/.."
src="vendor-build/codemirror"
out="public/js/vendor/codemirror.js"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

cp "$src/package.json" "$src/entry.mjs" "$work/"
if [ -f "$src/package-lock.json" ]; then
  cp "$src/package-lock.json" "$work/"
  (cd "$work" && npm ci --no-audit --no-fund --silent)
else
  (cd "$work" && npm install --no-audit --no-fund --silent)
  cp "$work/package-lock.json" "$src/package-lock.json"
fi

versions=$(cd "$work" && node -e '
  const deps = require("./package.json").dependencies;
  const version = (d) => JSON.parse(require("fs").readFileSync(`node_modules/${d}/package.json`)).version;
  console.log(Object.keys(deps).map((d) => `${d}@${version(d)}`).join(", "));
')

mkdir -p "$(dirname "$out")"
(cd "$work" && npx esbuild entry.mjs --bundle --format=esm --minify --legal-comments=eof \
  --banner:js="// Generated by bin/build-codemirror-bundle - do not edit. CodeMirror (MIT license): ${versions}" \
  --outfile=bundle.js --log-level=warning)
cp "$work/bundle.js" "$out"
echo "Wrote $out ($(wc -c < "$out" | tr -d ' ') bytes)"
