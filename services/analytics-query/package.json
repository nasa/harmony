{
  "name": "analytics-query",
  "version": "1.0.0",
  "description": "microservice that runs validated, read-only SQL queries against the Harmony Iceberg analytics tables",
  "main": "server.ts",
  "scripts": {
    "start": "ts-node app/server.ts",
    "start-dev": "strict-npm-engines && ts-node-dev --no-notify -r tsconfig-paths/register --respawn app/server",
    "start-dev-fast": "TS_NODE_TRANSPILE_ONLY=true ts-node-dev --no-notify -r tsconfig-paths/register --respawn --inspect=127.0.0.1:${DEBUG_PORT:-9307} app/server",
    "test": "npm run lint && nyc mocha && npm run better-audit",
    "test-fast": "TS_NODE_TRANSPILE_ONLY=true mocha",
    "lint": "eslint .",
    "coverage": "nyc mocha",
    "prebuild": "./bin/prebuild",
    "prebuild-m1": "./bin/prebuild",
    "build": "tsc --project ./tsconfig.build.json && docker build --tag harmonyservices/analytics-query:${VERSION:-latest} .",
    "build-m1": "tsc --project ./tsconfig.build.json && docker build --platform linux/amd64 --tag harmonyservices/analytics-query:${VERSION:-latest} .",
    "build-multi": "./bin/prebuild && tsc --project ./tsconfig.build.json && docker buildx build --platform=linux/amd64,linux/arm64 -t harmonyservices/analytics-query:${VERSION:-latest} --push .",
    "push-image": "./bin/push-image ${VERSION:-latest}",
    "publish": "docker push harmonyservices/analytics-query:${VERSION:-latest}",
    "better-audit": "better-npm-audit audit -l moderate -p"
  },
  "engines": {
    "node": "^22.23.4",
    "npm": ">=10"
  },
  "author": "NASA EOSDIS Harmony team",
  "license": "Apache-2.0",
  "lockedDependenciesComments": {
    "@duckdb/node-api": "Pinned to the same version as the cron service, which writes the Iceberg tables",
    "chai": "Version 5 requires ESM which breaks running mocha. It's not clear what changes need to be made to fix it.",
    "chai-as-promised": "Version 8 requires ESM",
    "@types/chai": "Chai dependency is locked",
    "@types/chai-as-promised": "chai-as-promised dependency is locked"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.1",
    "@harmony/util": "file:../../packages/util",
    "class-validator": "^0.14.0",
    "dotenv": "^16.4.7",
    "express": "^4.17.3",
    "lodash": "^4.17.21",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/chai": ">=4.3.20 <5.0.0",
    "@types/chai-as-promised": ">=7.1.8 <8.0.0",
    "@types/express": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@types/supertest": "^6.0.2",
    "better-npm-audit": "^3.7.3",
    "chai": ">=4.5.0 <5.0.0",
    "chai-as-promised": ">=7.1.2 <8.0.0",
    "mocha": "^11.0.1",
    "nyc": "^17.1.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.4.0",
    "typescript": "^5.7.2"
  }
}
