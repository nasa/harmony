# Port the health check server listens on
PORT=3000

WORKING_DIR=/tmp
# SQS queue used to request scheduling of work items for a service
WORK_ITEM_SCHEDULER_QUEUE_URL=http://sqs.us-west-2.localhost.localstack.cloud:4566/000000000000/work-item-scheduler-queue
# Maximum number of messages to pull from the scheduler queue at once
WORK_ITEM_SCHEDULER_QUEUE_MAX_BATCH_SIZE=10
# Maximum number of SQS getMessage requests to make to the scheduler queue on each run
# If WORK_ITEM_SCHEDULER_QUEUE_MAX_BATCH_SIZE is 10 and
# WORK_ITEM_SCHEDULER_QUEUE_MAX_GET_MESSAGE_REQUESTS is 20 we will grab 10 * 20 = 200 messages at once
WORK_ITEM_SCHEDULER_QUEUE_MAX_GET_MESSAGE_REQUESTS=10
# Used to allow slightly more work items to be queued than the number of available workers
# to avoid queue starvation. 1.1 for example means to queue 10% more work items than there
# are running pods for the service.
SERVICE_QUEUE_BATCH_SIZE_COEFFICIENT=0.25
# Used to allow queueing more work items for fast services (e.g. query-cmr) to avoid queue starvation.
FAST_SERVICE_QUEUE_BATCH_SIZE_COEFFICIENT=1.25
# Maximum number of work items to retrieve from database at once
WORK_ITEM_SCHEDULER_BATCH_SIZE=50
# Maximum number of work items allowed on the work item update queue before halting scheduling
# Set the value to -1 to always schedule work
MAX_WORK_ITEMS_ON_UPDATE_QUEUE=1200
# CACHE TTL in milliseconds for caching the number of service and scheduler pods to avoid
# excessive lookups - 90 seconds
POD_COUNT_CACHE_TTL=90000

# The fair queueing policy: how the work-scheduler chooses which jobs' work items to queue for a
# service. See docs/fair-queueing.md.
#   slot-based (the default) - users are ranked by their number of running work items; there is
#     no fast lane reserve, and SLOW_WORK_THRESHOLD_MS, FAST_LANE_RESERVE_FRACTION and the
#     FAIR_SHARE_FAST_LANE_* settings are ignored.
#   duration-based - users are ranked by the expected runtime of their running work items, and
#     slow work is limited by the fast lane reserve (FAST_LANE_RESERVE_FRACTION).
#   fair-share-fast-lane - duration-based with fixes that stop one user's slow work items taking a
#     service, and sync requests first (the FAIR_SHARE_FAST_LANE_* settings below). Its fast lane
#     reserve is FAIR_SHARE_FAST_LANE_RESERVE_FRACTION.
FAIR_QUEUEING_POLICY=slot-based

# The older setting for duration based fair queueing, kept for existing deployments: true is the
# same as FAIR_QUEUEING_POLICY=duration-based, unless FAIR_QUEUEING_POLICY selects a policy other
# than slot-based.
ENABLE_DURATION_BASED_FAIR_QUEUEING=false

# Average work item duration (in ms), per job and service, above which all work items for that
# job and service are classified as "slow" for fair queueing purposes. Used by duration-based and
# fair-share-fast-lane.
SLOW_WORK_THRESHOLD_MS=600000

# The fraction of a service's capacity (currently running pods) reserved for fast work items.
# Slow work items are only blocked once running slow work occupies the rest of the capacity, so
# short work items keep flowing even while slow work is busy. Used by duration-based (and by
# fair-share-fast-lane when FAIR_SHARE_FAST_LANE_RESERVE_FRACTION is "scheduler").
FAST_LANE_RESERVE_FRACTION=0.3

# Settings for FAIR_QUEUEING_POLICY=fair-share-fast-lane, read on every scheduling pass. The fix
# numbers are those in harmony's fair-share-fast-lane-policy (app/backends/workflow-orchestration),
# where each fix is described; the defaults are the configuration chosen with the fair queueing
# simulator (tools/fair-queueing-sim/RESULTS.md).
#
# The fraction of a service's pods fair-share-fast-lane's slow work may never use ("scheduler" =
# FAST_LANE_RESERVE_FRACTION).
FAIR_SHARE_FAST_LANE_RESERVE_FRACTION=0.1
# Fix 1: the most work items that may run for a (job, service) before it has a measured duration
# (0 = no limit), and beyond that, the fraction of the slow work capacity all unmeasured work on
# the service may use together (0 = just the limit).
FAIR_SHARE_FAST_LANE_UNMEASURED_LIMIT=2
FAIR_SHARE_FAST_LANE_UNMEASURED_FRACTION=0.5
# Fix 3: "service" = when ranking users, unmeasured work counts as the service's mean measured
# duration; "fixed" = FAIR_SHARE_FAST_LANE_UNMEASURED_DEFAULT_MS, the expected duration of unmeasured
# work when there is nothing better to go on.
FAIR_SHARE_FAST_LANE_UNMEASURED_ESTIMATE=service
FAIR_SHARE_FAST_LANE_UNMEASURED_DEFAULT_MS=3600000
# Fix 4: split each scheduling batch between users first (false = evenly per job).
FAIR_SHARE_FAST_LANE_SPLIT_BY_USER=true
# Fix 6: while other users' fast work is ready, hold a user's slow work to their fair share of
# the service's pods; with FAIR_SHARE_ALL, hold every user to their fair share while another user
# below theirs has work ready.
FAIR_SHARE_FAST_LANE_SLOW_FAIR_SHARE=true
FAIR_SHARE_FAST_LANE_FAIR_SHARE_ALL=true
# Fix 7: treat an unmeasured (job, service) as slow once one of its work items has been running
# longer than SLOW_WORK_THRESHOLD_MS, keeping fix 1's limits until it's measured.
FAIR_SHARE_FAST_LANE_RUNNING_EVIDENCE=true
FAIR_SHARE_FAST_LANE_RUNNING_EVIDENCE_KEEPS_LIMIT=true
# Fix 8: fair share never holds back a sync request, and each batch goes to sync requests first.
FAIR_SHARE_FAST_LANE_SYNC_EXEMPT=true
FAIR_SHARE_FAST_LANE_SYNC_FIRST=true
# Fixes 2 and 5 (FAIR_SHARE_FAST_LANE_EWMA_ALPHA, FAIR_SHARE_FAST_LANE_USE_SERVICE_DURATION) need work
# item durations Harmony doesn't keep, so they're only available in the simulator.
