# Port the health check server listens on
PORT=3000

# The cron schedule for the work reaper service
WORK_REAPER_CRON="*/6 * * * *" # every 6 minutes

# WorkItems and WorkflowSteps (in a terminal state) older than this many minutes are checked by the work reaper
REAPABLE_WORK_AGE_MINUTES=20160

# The batch size of the work reaper service
WORK_REAPER_BATCH_SIZE=2000

# The cron schedule for restarting Prometheus if it is down
RESTART_PROMETHEUS_CRON="*/10 * * * *" # every 10 minutes

# The cron schedule for the user work updater
USER_WORK_UPDATER_CRON="*/3 * * * *" # every 3 minutes

# Rows in user_work with no work completed within this time interval this will cause the
# ready and running counts for a job to be recalculated
USER_WORK_EXPIRATION_MINUTES=3

# The cron schedule for deleting old rows from the user_work_history table
USER_WORK_HISTORY_REAPER_CRON="23 * * * *" # every hour

# user_work_history rows for finished jobs that were last written more than this many days ago are
# deleted (they remain in Iceberg). Rows for jobs that aren't finished are never deleted. Should be
# at least USER_WORK_DURATION_SEED_LOOKBACK_DAYS, which seeds new jobs' durations from this table.
USER_WORK_HISTORY_RETENTION_DAYS=30

# The maximum number of user_work_history rows deleted per statement by the reaper
USER_WORK_HISTORY_REAPER_BATCH_SIZE=5000

# The cron schedule for publishing service failure metrics to CloudWatch
PUBLISH_SERVICE_FAILURE_METRICS_CRON="0,30 * * * *" # every half hour

# How far to go back from the current time when computing service failure percentages.
# This should correspond to how often the computation runs based on
# PUBLISH_SERVICE_FAILURE_METRICS_CRON
FAILURE_METRICS_LOOK_BACK_MINUTES=30

# The cron schedule for collecting memory usage metrics for backend services
MEMORY_USAGE_COLLECTOR_CRON="0 * * * *" # run once an hour

# How far to go back from the current time when looking for max memory usage for services.
# This should correspond to how often the computation runs based on
# MEMORY_USAGE_COLLECTOR_CRON
MEMORY_USAGE_COLLECTOR_LOOK_BACK_MINUTES=60

# The Prometheus server that scrapes cAdvisor container memory metrics
MEMORY_USAGE_PROMETHEUS_URL=http://prometheus.monitoring:9090

# The bucket where memory usage metrics are stored
MEMORY_USAGE_BUCKET=memory-usage-bucket

# The cron schedule for the work items stats cron
WORK_ITEMS_STATS_CRON="* * * * *" # every minute

# Hourly rows of the dashboard stats tables older than this many days are deleted. (Per-minute
# rows are kept for WORK_ITEMS_STATS_MINUTE_RETENTION_DAYS, in packages/util/env-defaults.)
WORK_ITEMS_STATS_HOURLY_RETENTION_DAYS=400

# The maximum number of hours of expired rows deleted from each dashboard stats table per run of
# the work items stats cron, one hour per statement - this spreads deleting a large backlog of
# expired rows across many runs instead of holding one huge delete
WORK_ITEMS_STATS_PRUNE_HOURS_PER_RUN=6

# The harmony environment (e.g. sit, uat, prod)
HARMONY_ENVIRONMENT=local

# The analytics schedule
ANALYTICS_CRON="0 */8 * * *" # every eight hours

# the max number of rows to process at once for the analytics updates. Each batch is merged into
# Iceberg by duckdb in a single MERGE, and duckdb's memory use for that MERGE grows with the batch
# size - and well beyond ANALYTICS_UPDATE_MEMORY_LIMIT, since much of it isn't counted against
# that limit. 100000-row batches of jobs got the cron service OOM killed with a 3Gi memory limit.
ANALYTICS_UPDATE_BATCH_SIZE=25000

# the number of rows read from postgres at a time while building each batch above - only this
# many rows are held in memory at once, so this, not the batch size, bounds node's memory use
ANALYTICS_UPDATE_PAGE_SIZE=5000

# the memory limit for duckdb. This only limits duckdb's buffer manager, so duckdb's actual
# memory use runs higher, and it shares the container's memory with node - keep it well under
# the cron service's memory limit (CRON_SERVICE_LIMITS_MEMORY) or the container gets OOM killed
ANALYTICS_UPDATE_MEMORY_LIMIT="1GB"

# the number of threads used by duckdb
ANALYTICS_UPDATE_THREADS=2

# The ARN of the S3 Table bucket used to store Iceberg analytics tables, used both for the
# real AWS connection and (via bin/create-iceberg-tables against ministack) the local one.
S3_TABLE_BUCKET_ARN=
